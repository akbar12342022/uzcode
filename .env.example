# Copy to .env and fill in values:   cp .env.example .env

# ---- Database ----
DATABASE_URL="postgresql://uzcode:uzcode_dev_password@localhost:5433/uzcode?schema=public"

# ---- Auth (session signing) ----
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""

# ---- Judge0 (code execution) ----
# RapidAPI (default): subscribe to "Judge0 CE" on rapidapi.com and paste the key below.
# Self-hosted instead: set JUDGE0_URL="http://localhost:2358", leave the RapidAPI key
# empty, and set JUDGE0_AUTH_TOKEN if the instance requires one.
JUDGE0_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_RAPIDAPI_KEY=""
JUDGE0_AUTH_TOKEN=""
